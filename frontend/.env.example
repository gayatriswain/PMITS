
# ---------------------------------------------------------------------------
# ProManage CMS (Next.js + MongoDB, folder ../cms) - see ../cms/README.md
# ---------------------------------------------------------------------------
# Where the website reads content from (server-side) ...
CMS_URL=http://localhost:4000
# ... and where browser forms POST enquiries (/api/leads, /api/proposals, /api/forms).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public URL of this website (canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Same value as REVALIDATE_SECRET in cms/.env.local (publish refresh + preview links).
REVALIDATE_SECRET=
# Set to "true" only on the live production site so search engines may index it.
ALLOW_INDEXING=false
