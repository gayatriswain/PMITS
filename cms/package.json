{
  "name": "promanage-cms",
  "version": "0.1.0",
  "private": true,
  "description": "ProManage IT Solution - Next.js + MongoDB backend, public content API and admin CMS",
  "scripts": {
    "dev": "next dev --port 4000",
    "build": "next build",
    "start": "next start --port 4000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:dev": "tsx scripts/dev-mongo.ts",
    "db:export": "tsx scripts/db-snapshot.ts export",
    "db:import": "tsx scripts/db-snapshot.ts import",
    "admin:create": "tsx scripts/create-admin.ts",
    "seed": "tsx scripts/seed.ts",
    "test:api": "tsx scripts/smoke-test.ts",
    "test:mail": "tsx scripts/mail-test.ts",
    "dev:unlock": "tsx scripts/clear-rate-limits.ts",
    "registry": "tsx scripts/generate-registry.ts && tsx scripts/generate-content-fields.ts",
    "content:codemod": "tsx scripts/content-codemod.ts"
  },
  "dependencies": {
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-link": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.48.0",
    "mongoose": "^9.12.3",
    "next": "16.3.4",
    "nodemailer": "^10.6.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.8.0",
    "sanitize-html": "^2.18.2",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.0",
    "@types/smtp-server": "^3.5.13",
    "dotenv": "^17.2.3",
    "entities": "^9.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "mongodb-memory-server": "^11.4.0",
    "smtp-server": "^3.21.7",
    "tailwindcss": "^4",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
