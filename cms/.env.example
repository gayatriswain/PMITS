# ---------------------------------------------------------------------------
# ProManage CMS (Next.js + MongoDB). Copy to .env.local and fill in.
# Never commit real values.
# ---------------------------------------------------------------------------

# MongoDB connection string. Local dev: run `npm run db:dev` and use the value below.
# Production: MongoDB Atlas / managed server, e.g. mongodb+srv://user:pass@cluster/promanage
MONGODB_URI=mongodb://127.0.0.1:27017/promanage

# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Shared with frontend/.env.local (same value): protects /api/revalidate and draft preview.
REVALIDATE_SECRET=

# Public URL of this CMS (admin + API) and of the public website.
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Admin session length in hours.
SESSION_HOURS=8

# Media storage: "local" (dev only - files saved to ./public/uploads) or "cloudinary" (production).
MEDIA_STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Outgoing email. Normally set in the admin panel (Email (SMTP) page) instead - these are only a
# fallback used while that page is switched off. Without any SMTP, reset links are printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ProManage CMS <no-reply@example.com>"

# Public website URL exposed to the admin UI (image previews, "view on site" links).
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
